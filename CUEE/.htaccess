Options -Indexes
ServerSignature Off

<FilesMatch "^(\.env|\.env\.example|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(ini|log|sh|sql|bak)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
</IfModule>
